# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# ASP.NET Core environment and allowed hosts
ASPNETCORE_ENVIRONMENT=Development

# * is safe when sitting behind a reverse proxy that validates the Host header.
# Restrict to your actual API hostname in production if not using a proxy (e.g. AllowedHosts=api.yourdomain.com).
AllowedHosts=*

# ASP.NET Core URLs — listen on all interfaces for local development
ASPNETCORE_URLS=http://*:5284

# CORS — comma-separated list of allowed frontend origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173,https://pulse-frontend.project-demo.app

# App base URL (used in email links)
APP_BASE_URL=https://pulse-frontend.project-demo.app

# Database connection string — the app's request path. In production this should be the
# limited, non-superuser `pulse_rls_app` role so row-level security applies (see docs/rls-runbook.md).
DB_CONNECTION=Host=localhost;Port=5432;Database=pulse_dev;Username=pulse;Password=change_me

# Privileged (owner) connection used ONLY for schema migrations and Hangfire storage.
# Optional — falls back to DB_CONNECTION when unset (fine for single-role local dev).
# DB_MIGRATION_CONNECTION=Host=localhost;Port=5432;Database=pulse_dev;Username=pulse_owner;Password=change_me
# The demo seeder (reset/clear) also runs on this owner connection, as the service role, because resetting needs sequence ownership.
# With a single role (the default above) row-level security does nothing locally.

# Local development only: enables the endpoints that wipe and reseed the database (POST /api/v1/demo/reset and /clear). They also
# need ASPNETCORE_ENVIRONMENT=Development, and refuse when the database holds more than one organization. The dotnet run launch
# profiles set this; NEVER set it on a server.
# ENABLE_DEMO_ENDPOINTS=true

# JWT — generate signing key with: openssl rand -base64 48
JWT_SECRET_KEY=change_me
JWT_ISSUER=pulse
JWT_AUDIENCE=pulse
JWT_ACCESS_EXPIRY_TIME=30
JWT_VERIFY_EMAIL_EXPIRY_TIME=24
JWT_FORGET_PASSWORD_EXPIRY_TIME=15

# SMTP — configure with your email provider's settings
Mail_Host=smtp.gmail.com
Mail_Port=587
Mail_User=you@yourdomain.com
Mail_Password=change_me
Mail_FromName=Pulse-Support
Mail_FromAddress=support@pulse.app
Mail_EnableSsl=true

# AI alert explanations — optional. Powers natural-language explanations on a fired
# alert; falls back to a plain templated message when unset (Alert Rules works
# completely without it).
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# Slack follow-up Q&A — optional. Requires a real Slack App (not just an incoming
# webhook) installed in the workspace, with the chat:write scope, bot invited to
# whichever channel(s) receive alerts, and its Event Subscriptions request URL set
# to /api/v1/integrations/slack/events. Only needed for in-thread follow-up
# questions on a fired alert — plain one-way delivery via a webhook URL pasted
# into an alert rule works without any of this.
# SLACK_SIGNING_SECRET=
# SLACK_BOT_TOKEN=
#
# Per-organization Slack (each org clicks "Connect Slack" and installs Pulse into its own workspace).
# Needs a Slack app with public distribution enabled, these bot scopes: chat:write, chat:write.public,
# channels:history, groups:history; event subscriptions message.channels and message.groups at the
# events URL above; and SLACK_OAUTH_REDIRECT_URI added as a Redirect URL under OAuth & Permissions.
# SLACK_SIGNING_SECRET above is the same app's. SLACK_BOT_TOKEN then only serves the default organization
# until it connects its own workspace.
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_OAUTH_REDIRECT_URI=https://api.example.com/api/v1/integrations/slack/oauth/callback
#
# Encrypts integration secrets stored in the database (organizations' Slack bot tokens).
# Generate with: openssl rand -base64 32. Changing it makes stored tokens unreadable (orgs reconnect).
# INTEGRATION_ENCRYPTION_KEY=

# Google Chat follow-up Q&A — optional. Requires a Google Chat app (Google Cloud)
# with a service account granted the Chat API's chat.bot scope, added to whichever
# space(s) receive alerts, with its endpoint set to
# /api/v1/integrations/google-chat/events. GOOGLE_CHAT_SERVICE_ACCOUNT_JSON is the
# raw JSON key content, not a file path. GOOGLE_CHAT_AUDIENCE is the expected `aud`
# claim on inbound requests (the Chat API app's configured audience), used to
# verify a request genuinely came from Google Chat.
# GOOGLE_CHAT_SERVICE_ACCOUNT_JSON=
# GOOGLE_CHAT_AUDIENCE=

# Operator API (multi-tenancy) — creates organizations via POST /api/v1/operator/organizations with
# header X-Operator-Key. Leave unset to disable the operator endpoints entirely (they return 404).
# Must be at least 32 characters; generate with: openssl rand -base64 48
# OPERATOR_API_KEY=
